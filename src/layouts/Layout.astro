---
import "../styles/global.css";

const {
  title = "Ursa fab. | Bespoke fabrication in Norwich",
  description = "Bespoke studio carts, production equipment and contemporary interiors, designed and built by Ursa fab. in Norwich, UK.",
  image = "/logo.jpeg"
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const socialImageURL = new URL(image, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Bespoke fabrication for creative production environments and contemporary interiors."
    />

    <title>{title}</title>

    <meta name="description" content={description} />

    {canonicalURL}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Ursa fab." />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={socialImageURL} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageURL} />

    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "LocalBusiness",
        name: "Ursa fab.",
        url: "https://ursafab.co.uk",
        email: "info@ursafab.co.uk",
        areaServed: "United Kingdom",
        address: {
          "@type": "PostalAddress",
          addressLocality: "Norwich",
          addressCountry: "GB"
        },
        sameAs: [
          "https://instagram.com/ursa.fab"
        ]
      })}
    />

    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/favicon.png" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;1,300;1,400;1,500&family=Inter:wght@300;400&display=swap"
      rel="stylesheet"
    />
  </head>

  <body>
    <slot />

    <script>
      function initialiseMenu() {
        const menuButton = document.getElementById("menuButton");
        const siteMenu = document.getElementById("siteMenu");
        const menuSymbol = menuButton?.querySelector("span");

        if (!menuButton || !siteMenu) {
          return;
        }

        function setMenuState(isOpen) {
          siteMenu.classList.toggle("open", isOpen);
          siteMenu.setAttribute("aria-hidden", String(!isOpen));
          menuButton.setAttribute("aria-expanded", String(isOpen));
          menuButton.setAttribute("aria-label", isOpen ? "Close menu" : "Open menu");

          if (menuSymbol) {
            menuSymbol.textContent = isOpen ? "×" : "☰";
          }
        }

        menuButton.addEventListener("click", () => {
          setMenuState(!siteMenu.classList.contains("open"));
        });

        siteMenu.querySelectorAll("a").forEach((link) => {
          link.addEventListener("click", () => setMenuState(false));
        });

        document.addEventListener("keydown", (event) => {
          if (event.key === "Escape") {
            setMenuState(false);
          }
        });

        setMenuState(false);
      }

      initialiseMenu();
    </script>
  </body>
</html>
