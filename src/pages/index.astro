---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import GalleryCard from "../components/GalleryCard.astro";
---

<Layout
  title="Ursa fab. | Bespoke fabrication in Norwich"
  description="Bespoke studio carts, production equipment and contemporary interiors, designed and built by Ursa fab. in Norwich, UK."
  image="/portfolio2.jpeg"
>
  <Header />
  <Hero />

  <main>
    <section class="gallery" aria-label="Explore Ursa fab.">
      <GalleryCard
        image="/about2.jpeg"
        title="ABOUT"
        href="/about/"
        alt="Ursa fab. workshop"
      />

      <GalleryCard
        image="/services2.jpeg"
        title="SERVICES"
        href="/services/"
        alt="Ursa fab. fabrication process"
      />

      <GalleryCard
        image="/portfolio2.jpeg"
        title="PORTFOLIO"
        href="/portfolio/"
        alt="Selected Ursa fab. work"
      />

    </section>
  </main>

  <footer>
    <p>Norwich, UK</p>
    <p><a href="mailto:info@ursafab.co.uk">info@ursafab.co.uk</a></p>
    <p>
      <a href="https://instagram.com/ursa.fab" target="_blank" rel="noopener noreferrer">
        @ursa.fab
      </a>
    </p>
    <p>
      <a href="https://www.ursafab.co.uk/privacy/">Privacy policy</a>
    </p>
    <p>
      <a href="/studio-cart-faq/">Studio cart FAQ</a>
    </p>
  </footer>

  <script>
    const siteHeader = document.getElementById("siteHeader");
    const heroLogo = document.getElementById("heroLogo");

    function updateHeader() {
      const showHeader = window.scrollY > 100;

      siteHeader?.classList.toggle("visible", showHeader);
      heroLogo?.classList.toggle("fade", showHeader);
    }

    updateHeader();

    window.addEventListener("scroll", updateHeader, {
      passive: true
    });

    const galleryCards =
      document.querySelectorAll(".gallery-card");

    const cardObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          entry.target.classList.toggle(
            "active",
            entry.isIntersecting
          );
        });
      },
      {
        root: null,
        rootMargin: "-40% 0px -40% 0px",
        threshold: 0
      }
    );

    galleryCards.forEach((card) => {
      cardObserver.observe(card);
    });
  </script>
</Layout>
