---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
---

<Layout title="Portfolio | Ursa fab.">
  <Header alwaysVisible />

  <main class="portfolio-page">
    <header class="portfolio-intro">
      <p class="content-label">portfolio</p>
      <h1>Selected works and projects.</h1>
    </header>

    <section class="portfolio-grid" aria-label="Selected Ursa fab. work">
      <figure class="portfolio-item">
        <img src="/wip.jpeg" alt="WIP" />
        <figcaption>
          <span>Oh hi -</span>
          <span></span>
        </figcaption>
      </figure>

      <figure class="portfolio-item">
        <div class="portfolio-placeholder" aria-label="Project image placeholder"></div>
        <figcaption>
          <span>I'm sorry,</span>
          <span></span>
        </figcaption>
      </figure>

      <figure class="portfolio-item">
        <div class="portfolio-placeholder" aria-label="Project image placeholder"></div>
        <figcaption>
          <span>Still working on this bit.</span>
          <span></span>
        </figcaption>
      </figure>
      
      <figure class="portfolio-item">
        <div class="portfolio-placeholder" aria-label="Project image placeholder"></div>
        <figcaption>
          <span>Check the instagram!</span>
          <span></span>
        </figcaption>
      </figure>
    </section>
  </main>
</Layout>
