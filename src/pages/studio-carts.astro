---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import StudioCartFaq from "../components/StudioCartFaq.astro";
import { getCollection, render } from "astro:content";

const entries = (await getCollection("studiocarts")).sort(
  (a, b) => a.data.order - b.data.order || a.data.title.localeCompare(b.data.title),
);
const cartsOrder = (await getCollection("ordering")).find(
  (entry) => entry.id === "studiocarts-order",
);
const cartsOrderIds = cartsOrder?.data.items.map((item) =>
  typeof item === "string" ? item : item.entry,
) || [];
const carts = cartsOrder
  ? cartsOrderIds
      .map((id) => entries.find((entry) => entry.id === id))
      .filter((entry): entry is (typeof entries)[number] => Boolean(entry))
      .concat(entries.filter((entry) => !cartsOrderIds.includes(entry.id)))
  : entries;
const faq = (await getCollection("faq"))[0]?.data.items || [];
---

<Layout
  title="Studio Cart Designs & Prices | Ursa fab. Norwich"
  description="Browse stock studio cart designs from Ursa fab. in Norwich, UK, including crate carts, flag carts and production equipment with images, prices and bespoke fabrication options."
  image="/uploads/crate-3-x-l2-s2.png"
>
  <Header alwaysVisible />

  <main class="services-page studio-carts-page">
    <header class="services-intro">
      <p class="content-label">studio carts</p>
      <h1>Stock designs.</h1>
    </header>

    <section class="services-list studio-carts-grid">
      {carts.map(async (cart) => {
        const { Content } = await render(cart);
        return (
        <article class="service-item studio-cart-item">
          <a
            class="studio-cart-card"
            href={`/studio-carts/${cart.id}/`}
            data-cart-trigger
            data-title={cart.data.title}
            data-price={`£${cart.data.price}`}
            data-description={cart.data.description || cart.body}
            data-images={JSON.stringify(cart.data.gallery)}
            aria-label={`View details for ${cart.data.title}`}
          >
            <img
              class="studio-cart-image"
              src={cart.data.thumbnail}
              alt={cart.data.imageAlt || `${cart.data.title} studio cart`}
              loading="lazy"
              decoding="async"
              sizes="(max-width: 600px) 50vw, 25vw"
            />
            <span class="studio-cart-card-caption">
            <h2>{cart.data.title}</h2>
            </span>
          </a>
        </article>
        );
      })}
    </section>

    <p>
      Looking for a tailored solution?{" "}
      <a class="service-description-link" href="/services/">
        Explore bespoke fabrication services
      </a>
    </p>
    <StudioCartFaq items={faq} />
  </main>

  <dialog class="portfolio-modal studio-cart-modal" data-cart-modal aria-label="Studio cart details">
    <div class="portfolio-modal-content">
      <button class="portfolio-modal-close" type="button" data-cart-close aria-label="Close studio cart details">X</button>
      <div class="portfolio-modal-gallery" data-cart-gallery>
        <button class="portfolio-modal-nav portfolio-modal-prev" type="button" data-cart-prev aria-label="Previous image">‹</button>
        <img data-cart-image alt="" />
        <button class="portfolio-modal-nav portfolio-modal-next" type="button" data-cart-next aria-label="Next image">›</button>
      </div>
      <p class="portfolio-modal-counter" data-cart-counter></p>
      <p class="content-label">studio cart</p>
      <h2 data-cart-title></h2>
      <p class="studio-cart-modal-price" data-cart-price></p>
      <div class="studio-cart-description" data-cart-description></div>
    </div>
  </dialog>

  <script>
    const cartModal = document.querySelector("[data-cart-modal]");
    const cartTitle = cartModal?.querySelector("[data-cart-title]");
    const cartPrice = cartModal?.querySelector("[data-cart-price]");
    const cartDescription = cartModal?.querySelector("[data-cart-description]");
    const cartGallery = cartModal?.querySelector("[data-cart-gallery]");
    const cartImage = cartModal?.querySelector("[data-cart-image]");
    const cartCounter = cartModal?.querySelector("[data-cart-counter]");
    const cartPrevious = cartModal?.querySelector("[data-cart-prev]");
    const cartNext = cartModal?.querySelector("[data-cart-next]");
    const cartClose = cartModal?.querySelector("[data-cart-close]");
    let cartImages: string[] = [];
    let cartImageIndex = 0;

    function renderCartImage() {
      if (!(cartImage instanceof HTMLImageElement) || !cartCounter || !cartPrevious || !cartNext) return;
      cartImage.src = cartImages[cartImageIndex] || "";
      cartImage.alt = `${cartTitle?.textContent || "Studio cart"} image ${cartImageIndex + 1}`;
      cartCounter.textContent = `${cartImageIndex + 1} / ${cartImages.length}`;
      cartPrevious.toggleAttribute("hidden", cartImages.length < 2);
      cartNext.toggleAttribute("hidden", cartImages.length < 2);
    }

    function moveCartImage(direction: number) {
      if (cartImages.length < 2) return;
      cartImageIndex = (cartImageIndex + direction + cartImages.length) % cartImages.length;
      renderCartImage();
    }

    document.querySelectorAll("[data-cart-trigger]").forEach((trigger) => {
      trigger.addEventListener("click", (event) => {
        event.preventDefault();
        if (!cartModal || !cartTitle || !cartPrice || !cartDescription) return;
        cartImages = JSON.parse(trigger.getAttribute("data-images") || "[]");
        cartImageIndex = 0;
        cartTitle.textContent = trigger.getAttribute("data-title") || "";
        cartPrice.textContent = trigger.getAttribute("data-price") || "";
        cartDescription.textContent = trigger.getAttribute("data-description") || "";
        renderCartImage();
        if (cartModal instanceof HTMLDialogElement) cartModal.showModal();
      });
    });

    cartPrevious?.addEventListener("click", () => moveCartImage(-1));
    cartNext?.addEventListener("click", () => moveCartImage(1));
    cartClose?.addEventListener("click", () => {
      if (cartModal instanceof HTMLDialogElement) cartModal.close();
    });
    cartModal?.addEventListener("click", (event) => {
      if (event.target === cartModal && cartModal instanceof HTMLDialogElement) cartModal.close();
    });
    cartModal?.addEventListener("keydown", (event) => {
      if (event.key === "ArrowLeft") moveCartImage(-1);
      if (event.key === "ArrowRight") moveCartImage(1);
    });

    let cartTouchStartX = 0;
    cartGallery?.addEventListener("touchstart", (event) => {
      cartTouchStartX = event.changedTouches[0]?.screenX || 0;
    }, { passive: true });
    cartGallery?.addEventListener("touchend", (event) => {
      const cartTouchEndX = event.changedTouches[0]?.screenX || 0;
      if (Math.abs(cartTouchEndX - cartTouchStartX) > 40) {
        moveCartImage(cartTouchEndX < cartTouchStartX ? 1 : -1);
      }
    }, { passive: true });
  </script>
</Layout>