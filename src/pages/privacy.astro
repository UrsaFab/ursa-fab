---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
---

<Layout
  title="Privacy | Ursa fab."
  description="How Ursa fab. handles website analytics, enquiries and personal information."
>
  <Header alwaysVisible />

  <main class="privacy-page">
    <header class="privacy-intro">
      <p class="content-label">privacy</p>
      <h1>Privacy notice</h1>
      <p class="privacy-updated">Last updated: 16 September 2026</p>
    </header>

    <div class="privacy-content">
      <section>
        <h2></h2>
        <p>
          Ursa fab. is an independent fabrication workshop based in Norwich, UK.
          For questions about this notice or personal information, contact <a href="mailto:info@ursafab.co.uk">info@ursafab.co.uk</a>.
          <br/>
          <br/>
          If you contact Ursa fab. by email, we may receive information such as
          your name, email address, telephone number, project details and any
          other information included in your enquiry.
          <br/>
          <br/>
          Information provided through an enquiry is used to respond, discuss
          potential work, prepare estimates or quotations, deliver agreed work,
          maintain relevant business records and meet legal or accounting
          obligations.
          <br/>
          <br/>
          This website uses Cloudflare Web Analytics to understand visits and
          website performance. Cloudflare states that Web Analytics does not use
          cookies or local storage to collect usage metrics and does not
          fingerprint individuals for analytics reporting.
          <br/>
          <br/>
          Personal information is not sold. Information may be shared with
          service providers where necessary to operate the website, communicate
          with you, deliver agreed work, obtain professional advice or comply
          with legal obligations.
          <br/>
          <br/>
          Enquiry and project information is retained only for as long as it is
          reasonably needed for the purposes described above, including relevant
          legal, accounting and record-keeping requirements. Information that is
          no longer needed is deleted or securely disposed of.
          <br/>
          <br/>
          Depending on the circumstances, you may have rights relating to your
          personal information, including access, correction, deletion,
          restriction, objection and data portability. You may also have the
          right to withdraw consent where consent is the basis for processing.
          <br/>
          <br/>
          To make a request, email <a href="mailto:info@ursafab.co.uk">info@ursafab.co.uk</a>.
          <br/>
          <br/>
          Please contact Ursa fab. first if you have a concern. You may also
          complain to the UK Information Commissioner's Office about the handling
          of personal information.
          <br/>
          <br/>
          This notice may be updated when the website, services or data-handling
          practices change. The latest version will be published on this page.
        </p>
      </section>
    </div>
  </main>
</Layout>

<style>
  .privacy-page {
    width: min(900px, calc(100% - 64px));
    margin: 0 auto;
    padding: 160px 0 96px;
  }

  .privacy-intro {
    position: static;
    min-height: auto;
    padding: 0;
    background: transparent;
    pointer-events: auto;
  }

  .privacy-intro h1 {
    margin-top: 20px;
    font-family: "Cormorant Garamond", Georgia, serif;
    font-size: clamp(42px, 7vw, 82px);
    font-weight: 300;
    line-height: 1;
  }

  .privacy-updated {
    margin-top: 18px;
    color: var(--grey);
    font-size: 14px;
  }

  .privacy-content {
    margin-top: 72px;
    border-top: 1px solid rgba(255, 255, 255, 0.22);
  }

  .privacy-content section {
    padding: 32px 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.22);
  }

  .privacy-content h2 {
    font-family: "Cormorant Garamond", Georgia, serif;
    font-size: clamp(28px, 4vw, 42px);
    font-style: italic;
    font-weight: 300;
    line-height: 1.1;
  }

  .privacy-content p {
    width: min(680px, 100%);
    margin-top: 16px;
    color: var(--grey);
    font-size: 16px;
    font-weight: 300;
    line-height: 1.8;
  }

  .privacy-content a {
    color: var(--white);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media (max-width: 768px) {
    .privacy-page {
      width: calc(100% - 32px);
      padding: 112px 0 72px;
    }

    .privacy-content {
      margin-top: 48px;
    }

    .privacy-content section {
      padding: 26px 0;
    }
  }
</style>
