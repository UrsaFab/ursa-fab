<style>
  .terms-page {
    width: min(900px, calc(100% - 64px));
    margin: 0 auto;
    padding: 160px 0 96px;
  }

  .terms-intro {
    position: static;
    min-height: auto;
    padding: 0;
    background: transparent;
    pointer-events: auto;
  }

  .terms-intro h1 {
    margin-top: 20px;
    font-family: "Cormorant Garamond", Georgia, serif;
    font-size: clamp(42px, 7vw, 62px);
    font-weight: 300;
    line-height: 1;
  }

  .terms-updated {
    margin-top: 18px;
    color: var(--grey);
    font-size: 14px;
  }

  .terms-content {
    margin-top: 72px;
    border-top: 0px solid rgba(255, 255, 255, 0.22);
  }

  .terms-content section {
    width: min(680px, 100%);
    padding: 16px 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.22);
  }

  .terms-content h2 {
    font-family: "Cormorant Garamond", Georgia, serif;
    font-size: clamp(28px, 4vw, 42px);
    font-style: italic;
    font-weight: 300;
    line-height: 1.1;
  }

  .terms-content p {
    width: min(680px, 100%);
    margin-top: 16px;
    color: var(--grey);
    font-size: 13px;
    font-weight: 300;
    line-height: 1.8;
  }

  .terms-content a {
    color: var(--white);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media (max-width: 768px) {
    .terms-page {
      width: calc(100% - 32px);
      padding: 112px 0 72px;
    }

    .terms-content {
      margin-top: 48px;
    }

    .terms-content section {
      padding: 26px 0;
    }
  }
</style>
