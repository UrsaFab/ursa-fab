---
const { alwaysVisible = false } = Astro.props;
---

<header
  id="siteHeader"
  class:list={[
    "site-header",
    { "always-visible": alwaysVisible }
  ]}
>
  <div class="header-brand">
    <a href="/" aria-label="Ursa fab. home">
      <img class="header-logo" src="/logocrop.jpg" alt="Ursa fab." />
    </a>
  </div>

  <div class="header-actions">
    <a
      class="instagram-link"
      href="https://instagram.com/ursa.fab"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Ursa fab. on Instagram"
    >
      <img class="instagram-icon" src="/gram.png" alt="" />
    </a>

    <button
      id="menuButton"
      class="menu-button"
      type="button"
      aria-label="Open menu"
      aria-expanded="false"
    >
      <span aria-hidden="true">☰</span>
    </button>
  </div>
</header>
<nav id="siteMenu" class="site-menu" aria-hidden="true">
  <a href="/about/">about</a>
  <a href="/portfolio/">portfolio</a>
  <a href="/services/">services</a>
</nav>
