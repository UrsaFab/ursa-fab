---
interface FaqItem {
  question: string;
  answer: string;
}

interface Props {
  items: FaqItem[];
  showLink?: boolean;
}

const { items, showLink = true } = Astro.props;
const faqStructuredData = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: items.map((item) => ({
    "@type": "Question",
    name: item.question,
    acceptedAnswer: {
      "@type": "Answer",
      text: item.answer,
    },
  })),
};
---

{showLink && (
  <p class="studio-cart-faq-link">
    <a class="service-description-link" href="/studio-cart-faq/">
      Studio cart FAQ
    </a>
  </p>
)}

{items.length > 0 && (
  <>
    <section id="studio-cart-faq" class="studio-cart-faq">
      <div class="studio-cart-faq-list">
        {items.map((item) => (
          <div class="studio-cart-faq-item">
            <p class="studio-cart-faq-question">{item.question}</p>
            <p>{item.answer}</p>
          </div>
        ))}
      </div>
    </section>
    <script
      type="application/ld+json"
      set:html={JSON.stringify(faqStructuredData)}
    />
  </>
)}
