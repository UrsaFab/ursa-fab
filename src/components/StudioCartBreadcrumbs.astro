---
interface Props {
  title: string;
  url: string;
}

const { title, url } = Astro.props;
const structuredData = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Studio carts",
      item: new URL("/studio-carts/", Astro.site).toString(),
    },
    {
      "@type": "ListItem",
      position: 2,
      name: title,
      item: new URL(url, Astro.site).toString(),
    },
  ],
};
---

<nav class="studio-cart-breadcrumbs" aria-label="Breadcrumb">
  <a href="/studio-carts/">Studio carts</a>
  <span aria-hidden="true">/</span>
  <span>{title}</span>
</nav>
<script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
